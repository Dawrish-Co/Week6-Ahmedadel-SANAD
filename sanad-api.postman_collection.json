{
  "info": {
    "name": "SANAD Training Application API",
    "description": "Postman collection for submitting and retrieving SANAD training applications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": "<JWT_BEARER_TOKEN>"
    }
  ],
  "item": [
    {
      "name": "Submit Training Application",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseId\": \"651f8a7e3b2c1d0012345678\",\n  \"notes\": \"Interested in Node.js track\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/applications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications"
          ]
        },
        "description": "Submit a training application."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response contains a created application', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('data');",
              "    pm.expect(json.data).to.be.an('object');",
              "    pm.expect(json.data).to.have.property('_id');",
              "    pm.expect(json.data).to.have.property('courseId');",
              "    pm.expect(json.data).to.have.property('applicantId');",
              "    pm.expect(json.data).to.have.property('status', 'PENDING');",
              "    pm.expect(json.data).to.have.property('createdBy');",
              "    pm.expect(json.data).to.have.property('updatedBy');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Fetch User Applications",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/applications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications"
          ]
        },
        "description": "Fetch applications belonging to the authenticated user."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Error Test Cases",
      "item": [
        {
          "name": "Submit Training Application - Unauthorized (No Token)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"651f8a7e3b2c1d0012345678\",\n  \"notes\": \"Interested in Node.js track\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "description": "Verify that submission without a Bearer token is rejected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit Training Application - Validation Error (Missing courseId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Interested in Node.js track\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "description": "Verify that a request without courseId fails validation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response reports validation failure', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('error', 'Validation failed');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
